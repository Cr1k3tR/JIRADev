# Copy to .env (or export in your shell) and fill in.
# Read automatically by the `anthropic` SDK — no code changes needed.
ANTHROPIC_API_KEY=

# synthetic (default) or jira_cloud (not yet implemented)
DATA_SOURCE=synthetic

# Only needed once DATA_SOURCE=jira_cloud is implemented and in use.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
